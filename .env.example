# Copiar a `.env` para cambiar la configuración local (`.env` no se commitea).
# Sin `.env` se usa el valor por defecto de fulvo/settings.py, salvo
# SECRET_KEY, que es obligatoria y no tiene valor por defecto.
# Solo van variables que existan en la clase Settings: una clave de más
# hace fallar el arranque.

# Desarrollo: archivo SQLite en la carpeta del proyecto.
DATABASE_URL=sqlite:///fulvo.db

# Contenedor, CI y producción: PostgreSQL con psycopg.
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/fulvo

# Clave con la que se firman los tokens JWT. OBLIGATORIA: sin ella la app no
# arranca. Generar una propia con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Algoritmo de firma de los tokens (HS256 por defecto).
ALGORITHM=HS256

# Minutos que dura un token (30 por defecto).
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Primer usuario administrador. Lo crea `python -m fulvo.carga_inicial`; si
# estas dos variables faltan, la carga no crea admin. Cambiar la contraseña.
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar-por-una-contrasena-larga
