# Copiar a `.env` para cambiar la configuración local (`.env` no se commitea).
# Sin `.env` se usa el valor por defecto de fulvo/settings.py.
# Solo van variables que existan en la clase Settings: una clave de más
# hace fallar el arranque.

# Desarrollo: archivo SQLite en la carpeta del proyecto.
DATABASE_URL=sqlite:///fulvo.db

# Contenedor, CI y producción: PostgreSQL con psycopg.
# DATABASE_URL=postgresql+psycopg://usuario:clave@localhost:5432/fulvo
